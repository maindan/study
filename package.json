{
  "name": "study",
  "version": "1.0.0",
  "private": true,
  "description": "Study: trilha de Linux, Java, Kotlin, OOP, Algoritmos, SQL e Android nativo.",
  "author": "Daniel Lima <daniel.lima@projexsystem.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "node scripts/seed-java.mjs",
    "electron": "electron .",
    "electron:dev": "set ELECTRON_DEV_URL=http://localhost:3000&&electron .",
    "app": "next build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "pack": "node scripts/make-icon.mjs && next build && electron-builder --dir",
    "dist": "node scripts/make-icon.mjs && next build && electron-builder --win"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "gray-matter": "^4.0.3",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-highlight": "^7.0.1",
    "highlight.js": "^11.11.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.daniellima.study",
    "productName": "Study",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!.next/cache/**",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Study",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
